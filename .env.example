# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-only key used by Server Components + Actions (never exposed to the browser).
# Preferred: the SERVICE-ROLE key — bypasses RLS, the hardened posture for this
# internal tool. Set this and drop migration 0003's anon policies to harden.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Fallback used only when the service-role key is unset (e.g. a quick MVP deploy).
# This is the public anon key; it runs as the `anon` role and relies on the anon
# RLS policies in migration 0003. Safe to expose, but anyone with it can read/write
# the tables — prefer the service-role key above for anything real.
# SUPABASE_ANON_KEY=YOUR-ANON-KEY
